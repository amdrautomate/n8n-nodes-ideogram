{
  "name": "@amdrautomate/n8n-nodes-ideogram",
  "version": "0.1.1",
  "description": "n8n community node for Ideogram: generate, edit, remix, upscale and describe images with crisp text rendering, generate video, run ad and product tools, and poll generations",
  "license": "MIT",
  "homepage": "https://github.com/amdrautomate/n8n-nodes-ideogram",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ideogram",
    "image generation",
    "text to image",
    "ai images",
    "inpainting",
    "upscale",
    "video generation",
    "ad creative"
  ],
  "author": {
    "name": "Alicia Graham",
    "email": "hello@amdrautomate.ai",
    "url": "https://amdrautomate.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amdrautomate/n8n-nodes-ideogram.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/IdeogramApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Ideogram/Ideogram.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/amdrautomate/n8n-nodes-ideogram/issues"
  },
  "engines": {
    "node": ">=20.15"
  }
}
